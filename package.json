{
  "name": "foundry",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --recursive --filter './packages/*' run build",
    "format": "pnpm run build && prettier --write . --ignore-path node_modules/@cteic/prettier-config/prettierignore --ignore-path .prettierignore",
    "format:check": "pnpm run build && prettier --check . --ignore-path node_modules/@cteic/prettier-config/prettierignore --ignore-path .prettierignore",
    "lint": "pnpm run build && eslint .",
    "typecheck": "pnpm run build && pnpm --recursive run typecheck && tsc -p tsconfig.json",
    "test": "pnpm run build && vitest run && node --test scripts/*.test.mjs && node scripts/check-coderabbit-drift.mjs .coderabbit.yaml && node packages/install-policy/dist/cli.js && node scripts/toolchain-report.mjs --check",
    "changeset": "changeset",
    "bench:toolchain": "node scripts/toolchain-bench.mjs",
    "bench:report": "node scripts/toolchain-report.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@cteic/eslint-config": "workspace:*",
    "@cteic/prettier-config": "workspace:*",
    "@cteic/tsconfig": "workspace:*",
    "@cteic/vitest-config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
