{
  "name": "foundry",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --recursive --filter './packages/*' run build",
    "format": "pnpm run build && prettier --write .",
    "format:check": "pnpm run build && prettier --check .",
    "lint": "pnpm run build && eslint .",
    "typecheck": "pnpm run build && pnpm --recursive run typecheck && tsc -p tsconfig.json",
    "test": "pnpm run build && vitest run && node --test scripts/*.test.mjs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@cteic/eslint-config": "workspace:*",
    "@cteic/prettier-config": "workspace:*",
    "@cteic/tsconfig": "workspace:*",
    "@cteic/vitest-config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
