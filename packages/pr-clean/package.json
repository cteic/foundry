{
  "name": "@cteic/pr-clean",
  "version": "1.0.1",
  "description": "CLI that checks a branch for wrong authorship, tool credit lines and em dashes before review",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cteic/foundry.git",
    "directory": "packages/pr-clean"
  },
  "bin": {
    "pr-clean": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@cteic/tsconfig": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
