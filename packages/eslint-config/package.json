{
  "name": "@cteic/eslint-config",
  "version": "0.0.0",
  "description": "Shared ESLint flat config for cteic projects",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cteic/foundry.git",
    "directory": "packages/eslint-config"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/fixtures/tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.2"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=5.8.0 <6.1.0"
  },
  "devDependencies": {
    "@cteic/tsconfig": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
