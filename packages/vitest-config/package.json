{
  "name": "@cteic/vitest-config",
  "version": "0.0.0",
  "description": "Shared Vitest config for cteic projects",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cteic/foundry.git",
    "directory": "packages/vitest-config"
  },
  "exports": {
    ".": {
