{
  "name": "@cteic/playwright-config",
  "version": "0.0.0",
  "description": "Shared Playwright config for cteic projects, with visual regression defaults",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cteic/foundry.git",
    "directory": "packages/playwright-config"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@playwright/test": "^1.50.0"
  },
  "devDependencies": {
    "@cteic/tsconfig": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
